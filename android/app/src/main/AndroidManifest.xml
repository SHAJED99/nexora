<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- E04-T03b: real Bluetooth Classic discovery/connect (FR-DISC-001/002,
         FR-PLAT-002). Legacy pair for API <=30 (BLUETOOTH/BLUETOOTH_ADMIN are
         install-time-granted "normal" permissions; ACCESS_FINE_LOCATION is a
         runtime permission Android has historically required for discovery
         to actually return results pre-Android-12), modern pair for API 31+.
         BluetoothPermissions.kt branches on Build.VERSION.SDK_INT to request
         only the set that applies. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- E09-T05 (OQ-E09-T05-2(a), human-approved 2026-09-04): lifted from
         android:maxSdkVersion="30" to an unrestricted declaration; this is
         now E09's own runtime location permission (FR-LOC-003), needed on
         EVERY API level, not just the pre-Android-12 Bluetooth-discovery
         reason E04-T03b originally added it for. `geolocator`'s own library
         AndroidManifest.xml (geolocator_android-5.0.2, verified in the pub
         cache) does NOT declare this permission itself; only its example
         app does, so there is no manifest-merger conflict to resolve here;
         removing the cap in place, rather than adding a second
         <uses-permission> element with the same name (which the merger
         rejects as a duplicate/conflicting attribute), is the shape that
         avoids one. E04's own `BluetoothPermissions.kt` still branches on
         SDK_INT and never requests this permission for a Bluetooth scan on
         API 31+ (it relies on BLUETOOTH_SCAN's own `neverForLocation` flag
         below, unchanged); this permission now simply also existing on
         API 31+ for a DIFFERENT feature (location sharing) does not change
         what that scan itself asserts or needs. This reasoning is a static
         source-level argument, NOT an on-device verification: task file §8
         manual steps 4/5 (confirming E04's Bluetooth discovery actually
         still works on a real API <=30 device and a real API 31+ device
         after this change) were NOT performed; no physical device or
         emulator was available when this was built (task file §9, E09-B03).
         This remains an open verification obligation, not a completed one. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- E10-T01: runtime notification permission on API 33+ (FR-NOTIFY-001,
         FR-PLAT-003). NotificationApiHost.kt branches on
         Build.VERSION.SDK_INT — no-op below API 33, where no such runtime
         permission exists. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- E10-T08 / ADR-0007 option 1: a foreground service keeps the app
         process alive and legal in the background so MessagingCoordinator's
         existing Timer.periodic keeps firing (FR-PLAT-001/002/003).
         FOREGROUND_SERVICE_CONNECTED_DEVICE is the typed permission chosen
         in ADR-0007 §S1, accurate to what ForegroundMeshService does
         (maintains peer connections), not the broader dataSync type.
         RECEIVE_BOOT_COMPLETED backs BootReceiver (ADR-0007 §S3): restarts
         the service after reboot only if the persisted "messaging active"
         flag was on at last shutdown. No REQUEST_IGNORE_BATTERY_OPTIMIZATIONS
         (ADR-0007 §S2, deferred). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application
        android:label="nexora"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- E10-T08 / ADR-0007 option 1: retains the FlutterEngine (via
             MainActivity's FlutterEngineCache wiring) so
             MessagingCoordinator's tick keeps running while backgrounded.
             connectedDevice matches ADR-0007 §S1 and the FOREGROUND_SERVICE_
             CONNECTED_DEVICE permission above; API 34 enforces that the
             declared type matches what the service does. -->
        <service
            android:name=".background.ForegroundMeshService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
        <!-- E10-T08 / ADR-0007 §S3: restarts ForegroundMeshService on boot,
             but only if BackgroundApiHost's persisted "messaging active"
             flag was on at last shutdown; see BootReceiver.kt.
             exported="true" is required here (E10-B01): BOOT_COMPLETED is
             broadcast by the system server under a different UID than this
             app's, and an exported="false" receiver never receives a
             cross-UID broadcast at all; Android's own boot-receiver docs
             declare it exported. Safe to export: onReceive hard-filters on
             the action string, then on the persisted flag (BootReceiver.kt),
             so a spoofed intent can at most start a service this app was
             already configured to start. -->
        <receiver
            android:name=".background.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
