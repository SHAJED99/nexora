node_modules/
.env
.env.*
!.env.example

# Per-run agent logs (adapters write these; metrics.csv is the durable record)
runs/*
!runs/.gitkeep

# Freeze signal dropped by the statusline hook
agent/handoffs/.FREEZE

# Agent isolation worktrees (Agent tool, isolation: "worktree") — never
# committed; leftover directories from worktrees that couldn't be cleanly
# removed (Windows path-length limits) previously got swept up by a broad
# `git add -A` as embedded git repos (L-process-004).
.claude/worktrees/

# harness-update's pre-overwrite backups — never committed, purely local safety net
.harness-update-backup/

# Design gate: contracts + golden are COMMITTED (they are the law).
# Reports are regenerated on every verify — noise.
design/reports/*
!design/reports/.gitkeep
design/.cache/

.DS_Store
*.log

# python bytecode
__pycache__/
*.pyc

# python virtualenv
.venv/

# rendered workshop deck (source is docs/WORKSHOP.md)
deck.html
deck.pdf

# Flutter/Dart build artifacts (E00-T04) — generated, never committed.
# Drift-generated *.g.dart files ARE committed (codegen output checked in
# like any other generated-but-reviewed source, per Drift convention).
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
*.iml
.idea/
android/.gradle/
android/local.properties
android/**/gradle-wrapper.jar
android/key.properties
**/android/app/debug
**/android/app/profile
**/android/app/release
