// E01-T02 — minimal Firebase account/device metadata wrapper.
//
// Scope (FR-FB-001/002, ADR-0005): the only Firestore data this epic
// writes is the account-id <-> device-id metadata mapping at
// `/users/{uid}/devices/{deviceId}` (see
// lib/core/services/firebase_metadata_service.dart). Restrict read/write
// to the authenticated owner only — nobody else, including other signed-in
// users, may read or write another account's device metadata.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/devices/{deviceId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Everything else is denied by default (no other collections are
    // written by this task — E11's fuller Firebase scope is out of bounds
    // here per task §4).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
