{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "devices": {
          "$deviceId": {
            ".validate": "newData.hasChildren(['deviceId', 'createdAt', 'lastSeenAt', 'platform'])",
            "deviceId": {
              ".validate": "newData.isString() && newData.val().length <= 128 && newData.val() === $deviceId"
            },
            "createdAt": {
              ".validate": "newData.isNumber()"
            },
            "lastSeenAt": {
              ".validate": "newData.isNumber() && newData.val() >= newData.parent().child('createdAt').val()"
            },
            "platform": {
              ".validate": "newData.isString() && newData.val().length <= 32"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "sync_cursors": {
          "$writer": {
            "$conversation": {
              "$about": {
                ".validate": "newData.hasChildren(['localDeviceId', 'remoteDeviceId', 'conversationId', 'lastConfirmedSequenceNumber', 'updatedAt'])",
                "localDeviceId": {
                  ".validate": "newData.isString() && newData.val().length <= 128"
                },
                "remoteDeviceId": {
                  ".validate": "newData.isString() && newData.val().length <= 128"
                },
                "conversationId": {
                  ".validate": "newData.isString() && newData.val().length <= 128"
                },
                "lastConfirmedSequenceNumber": {
                  ".validate": "newData.isNumber() && newData.val() >= 0"
                },
                "updatedAt": {
                  ".validate": "newData.isNumber()"
                },
                "$other": {
                  ".validate": false
                }
              }
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
